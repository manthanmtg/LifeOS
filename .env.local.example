# MongoDB connection string
# Create a free cluster at https://www.mongodb.com/cloud/atlas/register
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lifeos?retryWrites=true&w=majority
MONGODB_URI=

# Admin login password (choose a strong password)
ADMIN_PASSWORD=

# JWT signing secret (generate a random string, e.g. via: openssl rand -base64 32)
JWT_SECRET=

# Optional notification credential encryption key.
# If omitted, admin Settings -> Notifications can generate and retain one in MongoDB.
# For stricter secret separation, generate via: openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY=

# Optional Settings -> About build metadata overrides.
# Normal Netlify, Vercel, GitHub Actions, and local Git builds do not need these.
# LIFEOS_DEPLOYED_AT must be an ISO 8601 timestamp, for example:
# 2026-08-01T08:00:00.000Z
LIFEOS_COMMIT_SHA=
LIFEOS_DEPLOYED_AT=
LIFEOS_DEPLOY_PROVIDER=
LIFEOS_DEPLOY_CONTEXT=
LIFEOS_BRANCH=
LIFEOS_DEPLOY_ID=
